{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gloss review format 1",
  "type": "object",
  "properties": {
    "format": {
      "const": 1,
      "description": "Saved review format version."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Save number, one more than the revision replaced."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Reviewer name as typed."
    },
    "draft": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Main draft path within the shared folder, with / separators."
        },
        "etag": {
          "type": "string",
          "description": "Main draft etag when last saved."
        }
      },
      "required": [
        "file",
        "etag"
      ],
      "additionalProperties": false
    },
    "sent": {
      "type": "boolean",
      "description": "Whether Send was pressed."
    },
    "sentAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ],
      "description": "When Send was pressed, or null."
    },
    "updatedAt": {
      "$ref": "#/$defs/time"
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/proposal"
          },
          {
            "$ref": "#/$defs/commentItem"
          },
          {
            "$ref": "#/$defs/overall"
          }
        ]
      },
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "overall"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 0,
      "maxContains": 1,
      "description": "Review items, with unique ids and at most one overall comment. readReview enforces id uniqueness; importers must apply both schema validation and readReview checks."
    }
  },
  "required": [
    "format",
    "revision",
    "name",
    "draft",
    "sent",
    "sentAt",
    "updatedAt",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
      "description": "ISO 8601 timestamp, including a time-zone offset. readReview additionally rejects impossible calendar dates."
    },
    "quote": {
      "type": "object",
      "properties": {
        "exact": {
          "type": "string",
          "description": "Exact draft text, including an empty string for an insertion."
        },
        "prefix": {
          "type": "string",
          "description": "Up to 32 Unicode characters immediately before the quote.",
          "maxLength": 32
        },
        "suffix": {
          "type": "string",
          "description": "Up to 32 Unicode characters immediately after the quote.",
          "maxLength": 32
        }
      },
      "required": [
        "exact",
        "prefix",
        "suffix"
      ],
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Comment text."
        },
        "at": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "anchored": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$",
          "description": "Item identifier, unique within this review. readReview enforces uniqueness; importers must apply both schema validation and readReview checks."
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "file": {
          "type": "string",
          "description": "Path within the shared folder, with / separators."
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "description": "Quote start in the draft file, in UTF-16 code units, as JavaScript counts."
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        }
      },
      "required": [
        "id",
        "at",
        "file",
        "from",
        "quote",
        "comments"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$",
          "description": "Item identifier, unique within this review. readReview enforces uniqueness; importers must apply both schema validation and readReview checks."
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "file": {
          "type": "string",
          "description": "Path within the shared folder, with / separators."
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "description": "Quote start in the draft file, in UTF-16 code units, as JavaScript counts."
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "kind": {
          "const": "proposal"
        },
        "proposal": {
          "type": "string",
          "description": "New text replacing quote.exact."
        }
      },
      "required": [
        "id",
        "at",
        "file",
        "from",
        "quote",
        "comments",
        "kind",
        "proposal"
      ],
      "additionalProperties": false
    },
    "commentItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$",
          "description": "Item identifier, unique within this review. readReview enforces uniqueness; importers must apply both schema validation and readReview checks."
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "file": {
          "type": "string",
          "description": "Path within the shared folder, with / separators."
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "description": "Quote start in the draft file, in UTF-16 code units, as JavaScript counts."
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "comments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "kind": {
          "const": "comment"
        }
      },
      "required": [
        "id",
        "at",
        "file",
        "from",
        "quote",
        "comments",
        "kind"
      ],
      "additionalProperties": false
    },
    "overall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$",
          "description": "Item identifier, unique within this review. readReview enforces uniqueness; importers must apply both schema validation and readReview checks."
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "kind": {
          "const": "overall"
        },
        "text": {
          "type": "string",
          "description": "Overall review comment."
        }
      },
      "required": [
        "id",
        "at",
        "kind",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
