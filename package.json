{
  "name": "gloss-nextcloud",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.pure.json",
    "test": "vitest run",
    "structure": "depcruise src test --config .dependency-cruiser.cjs && knip",
    "check": "npm run build && npm run typecheck && npm run structure && npm test",
    "ci": "npm run typecheck && npm test && npm run structure && npm run build && git diff --exit-code -- js css"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "jsdom": "30.1.1",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "ajv": "8.20.0",
    "@playwright/test": "1.63.0",
    "pdfjs-dist": "6.5.438",
    "preact": "10.29.8",
    "@preact/signals": "2.11.4",
    "@types/node": "26.6.6"
  },
  "type": "module"
}
